{
  "ffmpeg_path": "ffmpeg",
  "ffprobe_path": "ffprobe",
  "whisper_model": "large-v3-turbo",
  "device": "auto",
  "compute_type": "default",
  "language": "ar",
  "whisper_task": "transcribe",
  "target_subtitle_language": "ar",
  "pre_padding_sec": 0.15,
  "post_padding_sec": 0.35,
  "min_segment_duration_sec": 1.0,
  "merge_threshold_sec": 0.75,
  "default_action": "black_mute",
  "expansion_mode": "word",
  "max_scene_duration_sec": 15.0,
  "subtitle_redaction_mode": "asterisks",
  "video_codec": "libx264",
  "audio_codec": "aac",
  "crf": 18,
  "preset": "medium",
  "audio_bitrate": "192k",
  "crossfade_ms": 20,
  "fuzzy_match_enabled": false,
  "fuzzy_match_threshold": 85.0,
  "diacritic_folding": true,
  "debug_mode": false,
  "output_directory": ""
}